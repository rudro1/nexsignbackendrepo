# NeXsign Backend Environment Variables
# Copy to .env and fill in real values.

PORT=5001
NODE_ENV=development

# Frontend app origin used in signing/approval email links.
# Must NOT be the backend/API URL — no /api path, no trailing slash.
# Local:       http://127.0.0.1:5174
# Production:  https://your-frontend.vercel.app
FRONTEND_URL=http://127.0.0.1:5174

# MongoDB Atlas
MONGO_URI=mongodb+srv://USER:PASS@cluster0.example.mongodb.net/nexsign?retryWrites=true&w=majority

# Auth (use a long random string in production)
JWT_SECRET=your_jwt_secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret
CLOUDINARY_FOLDER=NexsignDocs

# Gmail SMTP (App Password — not your normal Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# Legacy aliases (optional — emailService falls back to these if SMTP_* unset)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
